# ---- Backend (LOCAL POSTGRES ONLY) ---------------------------------
# Supabase is out of scope for this sprint (sponsor decision, 2026-09-08).
# Run the schema against a local instance; apply 001 -> 002 -> 004 -> 003.
DATABASE_URL=postgresql://localhost:5432/fde

# ---- Model routing (ADR-0009) --------------------------------------
# Org-level keys MUST send anthropic-workspace-id on every request.
# Prefer a workspace-scoped key from the Console and leave this blank.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
# Default for every source pull and internal DB query.
MODEL_SUBAGENT=claude-sonnet-5
# Arbitration and falsification only: red_team, discrepancy, heuristic_override,
# and the desk orchestrator's commit decision.
MODEL_ORCHESTRATOR=claude-opus-5
MODEL_JUDGE=claude-opus-5

# ---- Quote source (interim; entitled feed lands in sprint 2) -------
QUOTE_SOURCE=yahoo
QUOTE_MONTHLY_CALL_LIMIT=500        # set to the plan's actual cap before running
QUOTE_ENFORCE_DAILY_PACING=true     # a cap spent in week one fails in week two
QUOTE_DELAY_SECONDS=900             # what the source actually is; never 0 until entitled
QUOTE_STALENESS_CEILING_SECONDS=900 # older than this escalates rather than returns
QUOTE_TTL_REGULAR_SECONDS=60
QUOTE_TTL_CLOSED_SECONDS=3600

# ---- EDGAR ---------------------------------------------------------
# SEC fair-access policy requires a declared identity on every request and
# caps request rate. One shared rate-limited client, never per-agent HTTP.
EDGAR_USER_AGENT="FirmName ops@firm.example"
EDGAR_MAX_REQUESTS_PER_SECOND=8

# ---- Guardrails ----------------------------------------------------
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=45
HITL_QUEUE_TABLE=ops.hitl_queue
FAIL_LOUD=true

# ---- Eval ----------------------------------------------------------
EVAL_GOLDEN_PATH=eval_workflows/golden/golden_set.jsonl
EVAL_OUTPUT_DIR=eval_output
